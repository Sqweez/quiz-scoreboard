APP_NAME="Таблица квиза"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://quiz.example.com
# Sanctum grants session auth on /api to the APP_URL host by default; set
# SANCTUM_STATEFUL_DOMAINS only if the SPA is served from another host.
APP_PORT=8087

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=quiz_scoreboard
DB_USERNAME=quiz
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Comma-separated IPs/CIDRs of the VPS reverse proxy as seen by PHP.
TRUSTED_PROXIES=
